{
  "name": "@avada/api",
  "version": "1.0.0",
  "description": "Avada Website & CMS Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
